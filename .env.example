# App
APP_NAME=Signal Lab Research Agent
APP_VERSION=0.1.0
DEBUG=false

# API server (docs / scripts)
API_HOST=127.0.0.1
API_PORT=8000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_MODEL=qwen2.5:7b
# Fail fast if Ollama is down; allow long generation reads
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=180
# Soft limit per API process (local Ollama stampedes)
MAX_CONCURRENT_ASKS=4

# Generation / metrics
TOKEN_LIMIT=512
CONTEXT_WINDOW=32768

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
